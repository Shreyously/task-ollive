# =============================================================================
# Stage 1 — Builder (Node)
# =============================================================================
FROM node:20-alpine AS builder

RUN apk add --no-cache curl

WORKDIR /workspace

# Copy manifests first so Docker can cache the install layer.
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/
COPY apps/frontend/package.json ./apps/frontend/
COPY packages/inference-sdk/package.json ./packages/inference-sdk/
COPY packages/shared-types/package.json ./packages/shared-types/

RUN npm ci

# Copy full source.
COPY . .

# Build shared packages, then the frontend.
# VITE_API_BASE_URL is baked in at build time — override with --build-arg if needed.
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build --workspace @repo/shared-types || true
RUN npm run build --workspace @repo/frontend

# =============================================================================
# Stage 2 — Runner (Nginx)
# =============================================================================
FROM nginx:1.27-alpine AS runner

# Remove default nginx config and replace with SPA-friendly one.
RUN rm /etc/nginx/conf.d/default.conf
COPY docker/node/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built static assets.
COPY --from=builder /workspace/apps/frontend/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost/nginx-health || exit 1

CMD ["nginx", "-g", "daemon off;"]
