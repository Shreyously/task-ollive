# Shared
NODE_ENV=development
LOG_LEVEL=debug
CORRELATION_ID_HEADER=x-correlation-id

# API
API_PORT=3001
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:3001
API_CORS_ORIGIN=http://localhost:5173
API_INTERNAL_URL=http://api:3001

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llm_obs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=llm_obs
POSTGRES_PORT=5432

# Redis / BullMQ
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
INFERENCE_QUEUE_NAME=inference-events

# Docker Compose
COMPOSE_PROJECT_NAME=llm-obs

# Redaction
PII_REDACTION_ENABLED=true
PII_REDACTION_MODE=store_only

# Providers
GOOGLE_GENERATIVE_AI_API_KEY=replace-me
GROQ_API_KEY=replace-me

# Routing defaults
DEFAULT_PROVIDER=google
DEFAULT_MODEL=gemini-2.0-flash
FALLBACK_PROVIDER=groq
FALLBACK_MODEL=llama-3.3-70b
